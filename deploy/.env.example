# 复制为 deploy/.env 后填写；该文件已在 .gitignore 中。
# 只在 admins 表为空时生效：建好账号后建议删除这两行并重启容器。

# 管理员用户名
BLOG_ADMIN_USERNAME=admin

# 管理员口令：≥16 位，只在首次启动时使用，不会写入日志
BLOG_ADMIN_PASSWORD=CHANGE-ME-TO-A-LONG-PASSPHRASE

# 日志级别：debug | info | warn | error
BLOG_LOG_LEVEL=info

# ---------- 本地存储 ----------
# 图片与附件都由本站自己托管，没有图床/对象存储。
# 这两个目录在 compose.yaml 里是 bind mount，路径写的是容器内路径。
BLOG_UPLOAD_DIR=/data/blog/uploads
BLOG_FILE_DIR=/data/blog/files

# 单个附件上限（字节）。默认 20MB；图片上限固定 30MB（BLOG_UPLOAD_MAX_BYTES）。
BLOG_FILE_MAX_BYTES=20971520

# 备份落点（backup 任务写入 blog-YYYYMMDD.db / uploads-YYYYMMDD/ / files-YYYYMMDD/）。
# 要与 /data/blog 在同一个文件系统上，否则硬链接会退回复制。
BLOG_BACKUP_DIR=/data/blog/backup
