# 复制为 deploy/.env 后填写；该文件已在 .gitignore 中。
# 只在 admins 表为空时生效：建好账号后建议删除这两行并重启容器。

# 管理员用户名
BLOG_ADMIN_USERNAME=admin

# 管理员口令：≥16 位，只在首次启动时使用，不会写入日志
BLOG_ADMIN_PASSWORD=CHANGE-ME-TO-A-LONG-PASSPHRASE

# 日志级别：debug | info | warn | error
BLOG_LOG_LEVEL=info

# ---------- 图床（Cloudreve WebDAV，用于原图归档） ----------
# 不启用时上传照常工作，只是不做归档。
BLOG_CLOUDREVE_ENABLED=false

# Cloudreve 的 WebDAV 地址，通常形如 https://pan.example.com/dav
BLOG_CLOUDREVE_WEBDAV_URL=

# Cloudreve 账号（建议单独建一个只授权 /blog 目录的账号）
BLOG_CLOUDREVE_USERNAME=
# 口令若含 $，在 compose 的 .env 里必须写成 $$，否则会被变量插值吞掉
BLOG_CLOUDREVE_PASSWORD=

# 远端目录。注意这是相对 WebDAV 账号根目录的路径：
# 账号根目录若是网盘的 public 目录，填 /blog 就会落到 public/blog 下，
# 容器把原图写成 {base_path}/{sha256}.{ext}、变体写成 {base_path}/{sha256}_{480|960|1600|2400}.webp。
BLOG_CLOUDREVE_BASE_PATH=/blog

# 图床的匿名直出前缀；留空则不给正文图片加「查看原图」链接。
# 例：BLOG_CLOUDREVE_PUBLIC_BASE_URL=https://pan.example.com/public/blog
# 前置条件：图床存储策略的「文件名规则」必须是 {originname}（不能含 {uuid}/{randomkey8}），
# 否则博客算出的地址与实际文件名不一致，链接会 404。详见 docs/runbook.md §11.5。
BLOG_CLOUDREVE_PUBLIC_BASE_URL=

# 四档 WebP 变体是否也推上图床（true | false）
BLOG_CLOUDREVE_ARCHIVE_VARIANTS=true
